{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "On events schema",
  "type": "array",
  "items": {
    "type": "object",
    "title": "OnMethod",
    "required": ["name", "event", "return_type"],
    "properties": {
      "name": {
        "type": "string",
        "description": "Python method name"
      },
      "event": {
        "type": "string",
        "description": "Protocol event name"
      },
      "return_type": {
        "type": "string",
        "description": "Return type"
      },
      "category": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "common",
              "deals",
              "assets",
              "ui",
              "ai",
              "indicator",
              "signals"
            ]
          },
          {
            "type": "null"
          }
        ],
        "description": "Event category"
      },
      "doc": {
        "type": ["string", "null"],
        "description": "Method documentation"
      },
      "pydantic_model": {
        "type": ["string", "null"],
        "description": "Associated Pydantic model"
      }
    }
  }
}
